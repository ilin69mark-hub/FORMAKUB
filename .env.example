# Canonical site origin used for metadata, sitemap and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional owner-editable contact details. Leave empty until confirmed.
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Optional lead delivery adapters. Leave empty to store leads locally only.
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=
LEAD_WEBHOOK_URL=

# Calculation Admin auth (ADR-02, Keycloak/OIDC). Required in production.
# Realm formakub, client formakub-admin, audience formakub-admin-api.
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=formakub-admin
KEYCLOAK_AUDIENCE=formakub-admin-api
# Optional for confidential clients; public PKCE client leaves empty.
KEYCLOAK_CLIENT_SECRET=
# Секрет подписи OIDC state cookie; обязателен, минимум 32 символа.
FORMAKUB_AUTH_SECRET=
# Optional explicit callback URI behind reverse proxy.
FORMAKUB_AUTH_REDIRECT_URI=

# Admin UI feature gate. In production the admin UI is closed unless this is 1;
# it is not authentication (OIDC/RBAC still required).
FORMAKUB_ADMIN_UI=

# In-process recalculation worker; default enabled outside tests. Set 0 to disable.
FORMAKUB_RECALC_WORKER=

# NEW-N4 / D-9: явный production-маркер (production|development|test).
# В production требуется FORMAKUB_ENV=production; NODE_ENV=production также
# распознаётся, но не является единственным механизмом защиты.
FORMAKUB_ENV=
# Разрешение production-публикации Rules Snapshot. По умолчанию пусто —
# публикация заблокирована (CA-T-511). Допустимые значения: 0|1.
FORMAKUB_RULES_PUBLICATION_ENABLED=

# Calculation Admin storage (ADR-01 / INFRA-SQLITE-001).
# В production (NODE_ENV=production) требуется "sqlite" — иное значение
# останавливает запуск (без тихого fallback на JSON).
# Вне production по умолчанию "json-file" (тесты/миграция); явное включение:
# FORMAKUB_STORAGE=sqlite

# Резервное копирование (ADR-03). В production по умолчанию 1 час; 0 — выкл.
# FORMAKUB_BACKUP_INTERVAL_MS=3600000

# Внешнее S3-совместимое хранилище для копий вне рабочего volume (ADR-03).
# Полный набор обязателен для выгрузки; иначе копии остаются только локально.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_PREFIX=backups/
